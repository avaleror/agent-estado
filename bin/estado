#!/bin/sh
# Prepara un proyecto para compartir su estado con personas y con cualquier IA.
set -eu

VERSION=1

die() {
  echo "estado: $*" >&2
  exit 1
}

inv=$0
case $inv in
  */*) ;;
  *)
    inv=$(command -v "$0" || true)
    [ -n "$inv" ] || die "no encuentro el programa en PATH"
    ;;
esac

while [ -L "$inv" ]; do
  linkdir=$(dirname "$inv")
  link=$(readlink "$inv")
  case $link in
    /*) inv=$link ;;
    *) inv="$linkdir/$link" ;;
  esac
done

SCRIPT_DIR=$(cd "$(dirname "$inv")" && pwd)
PLANTILLAS=$(cd "$SCRIPT_DIR/../plantillas" && pwd)

ayuda() {
  cat <<'EOF'
estado — comparte el estado del proyecto con tu equipo y con cualquier IA

Uso:
  estado init      prepara este directorio
  estado ver       muestra ESTADO.md
  estado fecha     pone la fecha de hoy en ESTADO.md
  estado ayuda     muestra esta ayuda

init crea, si faltan, AGENTS.md, ESTADO.md, CLAUDE.md y la regla de Cursor.
Si esos archivos ya existen, conserva tu texto. El bloque del protocolo
(entre las marcas HTML) se actualiza. ESTADO.md no se modifica si ya existe.

En cada proyecto: entra en su carpeta y ejecuta estado init.
Los archivos resultantes van en git.
EOF
}

require_plantillas() {
  for f in protocolo.md claude-puente.md AGENTS.md ESTADO.md CLAUDE.md cursor-estado.mdc; do
    [ -f "$PLANTILLAS/$f" ] || die "falta $PLANTILLAS/$f"
  done
}

# Falla si un archivo tiene la marca de inicio y no la de cierre.
require_pair() {
  file=$1
  start=$2
  end=$3
  if [ -f "$file" ] && grep -q -F "$start" "$file" && ! grep -q -F "$end" "$file"; then
    die "$file tiene la marca de inicio y le falta la de cierre. No he cambiado nada."
  fi
}

replace_block() {
  file=$1
  start=$2
  end=$3
  block=$4
  tmp=$(mktemp)
  awk -v start="$start" -v end="$end" -v block="$block" '
    $0 == start {
      while ((getline line < block) > 0) print line
      close(block)
      skipping = 1
      next
    }
    $0 == end {
      skipping = 0
      next
    }
    skipping != 1 { print }
  ' "$file" > "$tmp"
  mv "$tmp" "$file"
}

ensure_block() {
  dest=$1
  template=$2
  block=$3
  start=$4
  end=$5
  label=$6

  if [ ! -f "$dest" ]; then
    cp "$template" "$dest"
    echo "creado $label"
    return
  fi

  if grep -q -F "$start" "$dest"; then
    replace_block "$dest" "$start" "$end" "$block"
    echo "actualizado $label"
  else
    printf '\n' >> "$dest"
    cat "$block" >> "$dest"
    echo "añadido el bloque de estado a $label"
  fi
}

set_fecha() {
  file=$1
  today=$(date +%Y-%m-%d)
  tmp=$(mktemp)
  if awk -v d="$today" '
    BEGIN { found = 0 }
    /^Actualizado:/ { print "Actualizado: " d; found = 1; next }
    { print }
    END { if (found == 0) exit 1 }
  ' "$file" > "$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"
    die "$file no tiene una línea Actualizado:"
  fi
}

rellenar_estado_nuevo() {
  set_fecha ESTADO.md
  nombre=$(git config user.name 2>/dev/null || true)
  if [ -n "$nombre" ]; then
    tmp=$(mktemp)
    awk -v n="$nombre" '
      /^Quién:[[:space:]]*$/ { print "Quién: " n; next }
      { print }
    ' ESTADO.md > "$tmp"
    mv "$tmp" ESTADO.md
  fi
}

cmd_ver() {
  [ -f ESTADO.md ] || die "aquí no hay ESTADO.md. Entra en el proyecto y ejecuta: estado init"
  cat ESTADO.md
}

cmd_fecha() {
  [ -f ESTADO.md ] || die "aquí no hay ESTADO.md. Entra en el proyecto y ejecuta: estado init"
  set_fecha ESTADO.md
  echo "Actualizado: $(date +%Y-%m-%d)"
}

cmd_init() {
  pwd_now=$(pwd)
  if [ "$pwd_now" = "$HOME" ] || [ "$pwd_now" = / ]; then
    die "no inicializo en esta carpeta. Entra en el repositorio del proyecto."
  fi

  require_plantillas
  require_pair AGENTS.md '<!-- estado-protocolo -->' '<!-- /estado-protocolo -->'
  require_pair CLAUDE.md '<!-- estado-claude -->' '<!-- /estado-claude -->'

  nuevo_estado=0
  if [ ! -f ESTADO.md ]; then
    nuevo_estado=1
  fi

  ensure_block AGENTS.md \
    "$PLANTILLAS/AGENTS.md" \
    "$PLANTILLAS/protocolo.md" \
    '<!-- estado-protocolo -->' \
    '<!-- /estado-protocolo -->' \
    AGENTS.md

  if [ "$nuevo_estado" -eq 1 ]; then
    cp "$PLANTILLAS/ESTADO.md" ESTADO.md
    rellenar_estado_nuevo
    echo "creado ESTADO.md"
  else
    echo "ESTADO.md ya existe: lo dejo como está"
  fi

  ensure_block CLAUDE.md \
    "$PLANTILLAS/CLAUDE.md" \
    "$PLANTILLAS/claude-puente.md" \
    '<!-- estado-claude -->' \
    '<!-- /estado-claude -->' \
    CLAUDE.md

  mkdir -p .cursor/rules
  cp "$PLANTILLAS/cursor-estado.mdc" .cursor/rules/estado.mdc
  echo "escrita .cursor/rules/estado.mdc"

  echo ""
  echo "Listo en $pwd_now"
  echo "Revisa la sección Proyecto de AGENTS.md y rellena ESTADO.md."
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Incluye estos archivos en el commit del proyecto."
  else
    echo "Esta carpeta todavía no es un repositorio git. Cuando lo sea, incluye estos archivos."
  fi
}

cmd=${1:-ayuda}

case $cmd in
  init) cmd_init ;;
  ver) cmd_ver ;;
  fecha) cmd_fecha ;;
  ayuda|-h|--help|help) ayuda ;;
  version|--version) echo "$VERSION" ;;
  *)
    echo "estado: orden desconocida: $cmd" >&2
    echo "" >&2
    ayuda >&2
    exit 1
    ;;
esac
